# Alchemy Sepolia HTTPS URL — get from https://dashboard.alchemy.com
ALCHEMY_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# Private key of test wallet (64 hex chars, with or without 0x prefix)
# NEVER use a wallet that holds mainnet funds. NEVER commit the real .env.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE_64_HEX_CHARS

# Optional: contract address for scripts/interact.js
# CONTRACT_ADDRESS=0x...
